{
  "FileLogging": {
    "FileSizeLimitMegabytes": 100,
    "Mode": "Auto",
    "Path": "logs/rtsp-ingest-service-.log",
    "RetainedFileCountLimit": 31
  },
  "Hls": {
    "EndedStreamRetention": "00:00:30",
    "MaxInitializationSegmentSize": 131072,
    "MaxSegmentDuration": "00:00:10",
    "MaxSegmentSize": 33554432,
    "MaxSessions": 100,
    "MaxSessionStorageMegabytes": 128,
    "MaxTotalStorageMegabytes": 2048,
    "PlaylistWindowSize": 6,
    "TargetSegmentDuration": "00:00:04"
  },
  "Http": {
    "Cors": {
      "AllowAnyOrigin": false,
      "AllowCredentials": false,
      "AllowedOrigins": [],
      "Enabled": false,
      "MaxAgeSeconds": 600
    },
    "CrossOriginResourcePolicy": "cross-origin",
    "KeepAliveTimeout": "00:02:00",
    "ListenAddress": "127.0.0.1",
    "MaxConnections": 1000,
    "Port": 8080,
    "RequestHeadersTimeout": "00:00:30"
  },
  "Lifetime": {
    "ShutdownTimeout": "00:00:30",
    "StartupTimeout": "00:01:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Management": {
    "Enabled": true
  },
  "Media": {
    "DiscontinuityThreshold": "00:00:10",
    "MaxNalUnitsPerSample": 256,
    "MaxSampleSize": 8388608
  },
  "Rtmp": {
    "Authentication": {
      "RateLimit": {
        "FailureLimit": 10,
        "Window": "00:01:00"
      }
    },
    "ConnectionTimeout": "00:00:30",
    "HandshakeTimeout": "00:00:10",
    "InboundChunkSize": 128,
    "ListenAddress": "0.0.0.0",
    "MaxBufferedBytes": 16777216,
    "MaxConnections": 100,
    "MaxMessageSize": 8388608,
    "OutboundChunkSize": 4096,
    "Port": 1935
  },
  "StreamCatalog": {
    "ReconciliationInterval": "00:00:30"
  },
  "StreamEvents": {
    "QueueCapacity": 1024
  },
  "Telemetry": {
    "Otlp": {
      "Enabled": false,
      "Endpoint": null,
      "ExportInterval": "00:00:15",
      "Protocol": "grpc"
    }
  },
  "Transcoding": {
    "AcceptedAudioCodecs": null,
    "AcceptedVideoCodecs": null,
    "Audio": {
      "BitrateKilobits": 160
    },
    "DrainTimeout": "00:00:05",
    "Enabled": true,
    "HardwareAcceleration": "None",
    "MaxBufferedAudioFrames": 500,
    "MaxBufferedVideoFrames": 120,
    "MaxConcurrentSessions": 16,
    "MaxInputFrameRate": 60,
    "MaxInputHeight": 3840,
    "MaxInputWidth": 3840,
    "MaxSessionBufferMegabytes": 64,
    "MaxTotalBufferMegabytes": 512,
    "OverloadPolicy": "DropUntilKeyframe",
    "Video": {
      "KeyframeInterval": null,
      "MaxBitrateKilobits": 8000,
      "Quantizer": 22
    }
  }
}
