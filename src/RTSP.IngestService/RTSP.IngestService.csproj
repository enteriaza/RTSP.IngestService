<Project Sdk="Microsoft.NET.Sdk.Worker">
    <!--
      StuDev.AotAnywhere enables Native AOT cross-compilation to linux-x64 from Windows (Zig linker and sysroot,
      restored from NuGet). On a Windows host publishing win-x64, the SDK links with the native MSVC toolchain.
    -->
    <Sdk Name="StuDev.AotAnywhere" Version="1.1.0" />

    <PropertyGroup>
        <RootNamespace>RTSP.IngestService</RootNamespace>
        <AssemblyName>RTSP.IngestService</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <PublishAot>true</PublishAot>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <!-- Native AOT disables EventSource by default. The OpenTelemetry SDK reports export failures only through its
             EventSources, which OpenTelemetryDiagnosticsListener forwards to the log; without this they are silent. -->
        <EventSourceSupport>true</EventSourceSupport>
    </PropertyGroup>

    <ItemGroup>
        <!-- Kestrel for the HTTP HLS origin. The shared framework also provides Microsoft.Extensions.Hosting. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="Serilog" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
        <!-- Local environment configuration is available to dotnet run but never shipped. -->
        <Content Update="appsettings.Development.json;appsettings.Production.json" CopyToPublishDirectory="Never" />
        <Content Update="appsettings.*.example.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RTSP.IngestService.Tests" />
    </ItemGroup>

</Project>
