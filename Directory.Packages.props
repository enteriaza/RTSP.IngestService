<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Production -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Systemd" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageVersion Include="Serilog" Version="4.4.0" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.1" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.21.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.3" />
    </ItemGroup>

</Project>
