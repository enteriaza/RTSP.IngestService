# Normalise text files to LF in the repository; the working-tree line ending follows core.autocrlf.
* text=auto

# Files consumed on Linux must keep LF in every working tree.
*.sh text eol=lf
*.service text eol=lf

# Windows scripts keep CRLF in every working tree.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
